CAPI=2:
name: uwcse:beehive:topology:0.2
description: Beehive topology package for DHCP client design

filesets:
    rtl:
        depend:
            - uwcse:beehive:common_inc
            - uwcse:beehive:pyhp_generator
        file_type: systemVerilogSource

targets:
    default:
        filesets: [rtl]
        generate: [pyhp_generate]

generate:
    pyhp_generate:
        generator: pyhp_gen
        parameters:
            process_me: [[beehive_topology_gen.sv.pyv, beehive_topology_gen.sv]]
