`include "noc_defs.vh"
`include "packet_defs.vh"
<%
import sys
import os
sys.path.append(os.environ["BEEHIVE_PROJECT_ROOT"] + "/tile_generator/")
from tile_generator import BeehiveConfig
from noc_if_gen import NocInterfaceGen
import logging
logging.basicConfig(level=logging.INFO)
design_path = os.environ["BEEHIVE_DESIGN_ROOT"]
tile_config = BeehiveConfig(design_path + "/tile_config.xml")
noc_if_generator = NocInterfaceGen()
%>
import beehive_topology::*;

module udp_test_sender_tile #(
     parameter SRC_X = -1
    ,parameter SRC_Y = -1
)(
     input clk
    ,input rst

    // Cocotb-driven inputs exposed at the tile boundary.
    ,input  logic                            trigger
    ,input  logic [`IP_ADDR_W-1:0]           in_src_ip
    ,input  logic [`IP_ADDR_W-1:0]           in_dst_ip
    ,input  logic [`PORT_NUM_W-1:0]          in_src_port
    ,input  logic [`PORT_NUM_W-1:0]          in_dst_port
    ,input  logic [`UDP_LENGTH_W-1:0]        in_payload_len
    ,input  logic [`NOC_DATA_WIDTH-1:0]      in_payload
    ,output logic                            sender_done

<%
    noc_if_str = noc_if_generator.genNocInterface(src="src", module="udp_test_sender",
         dst="dst", nocs=tile_config.nocs, noc_widths=tile_config.nocs_data_width)
    print(noc_if_str)
%>
);

<%
router_wires = noc_if_generator.genNocProcessorWires(inst_name="router", nocs=tile_config.nocs,
        noc_widths = tile_config.nocs_data_width)
print(router_wires)
%>

    logic                           noc_test_sender_in_val;
    logic   [`NOC_DATA_WIDTH-1:0]   noc_test_sender_in_data;
    logic                           test_sender_in_noc_rdy;

    logic                           test_sender_out_noc_val;
    logic   [`NOC_DATA_WIDTH-1:0]   test_sender_out_noc_data;
    logic                           noc_test_sender_out_rdy;

    noc_router_block #(
         .SRC_X (SRC_X  )
        ,.SRC_Y (SRC_Y  )
    ) test_sender_noc_router_block (
         .clk   (clk    )
        ,.rst   (rst    )
<%
    noc_ports = noc_if_generator.genNocInstantiation(src="src",
        port_name="router_block", dst="dst", noc_src="src", noc_dst="dst",
        module="udp_test_sender", nocs=tile_config.nocs)
    print(noc_ports)

    processor_ports = noc_if_generator.genNocProcessorInstantiation(module="router_block",
        processor="process", inst_name="router", nocs=tile_config.nocs)
    print(processor_ports)
%>
    );

    beehive_credit_to_valrdy #(
        .NOC_DATA_W (`NOC_DATA_WIDTH    )
    ) test_sender_rx_noc0_beehive_credit_to_valrdy (
         .clk   (clk)
        ,.reset (rst)

        ,.src_ctovr_data    (router_ctovr_data_noc0_data    )
        ,.src_ctovr_val     (router_ctovr_data_noc0_val     )
        ,.ctovr_src_yummy   (ctovr_router_data_noc0_yummy   )

        ,.ctovr_dst_data    (noc_test_sender_in_data        )
        ,.ctovr_dst_val     (noc_test_sender_in_val         )
        ,.dst_ctovr_rdy     (test_sender_in_noc_rdy         )
    );

    beehive_valrdy_to_credit #(
        .NOC_DATA_W (`NOC_DATA_WIDTH    )
    ) test_sender_tx_noc0_beehive_valrdy_to_credit (
         .clk       (clk)
        ,.reset     (rst)

        ,.src_vrtoc_data    (test_sender_out_noc_data       )
        ,.src_vrtoc_val     (test_sender_out_noc_val        )
        ,.vrtoc_src_rdy     (noc_test_sender_out_rdy        )

        ,.vrtoc_dst_data    (vrtoc_router_data_noc0_data    )
        ,.vrtoc_dst_val     (vrtoc_router_data_noc0_val     )
        ,.dst_vrtoc_yummy   (router_vrtoc_data_noc0_yummy   )
    );

    udp_test_sender_core #(
         .NOC_DATA_W (`NOC_DATA_WIDTH    )
        ,.SRC_X      (SRC_X              )
        ,.SRC_Y      (SRC_Y              )
        ,.SRC_FBITS  (PKT_IF_FBITS[`NOC_FBITS_WIDTH-1:0])
    ) sender_core (
         .clk(clk)
        ,.rst(rst)

        ,.trigger        (trigger        )
        ,.in_src_ip      (in_src_ip      )
        ,.in_dst_ip      (in_dst_ip      )
        ,.in_src_port    (in_src_port    )
        ,.in_dst_port    (in_dst_port    )
        ,.in_payload_len (in_payload_len )
        ,.in_payload     (in_payload     )
        ,.sender_done    (sender_done    )

        ,.noc_in_val     (noc_test_sender_in_val     )
        ,.noc_in_data    (noc_test_sender_in_data    )
        ,.noc_in_rdy     (test_sender_in_noc_rdy     )

        ,.noc_out_val    (test_sender_out_noc_val    )
        ,.noc_out_data   (test_sender_out_noc_data   )
        ,.noc_out_rdy    (noc_test_sender_out_rdy    )
    );
endmodule
