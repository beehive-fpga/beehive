CAPI=2:
name: uwcse:beehive:dhcp_client:0.1
description: Beehive DHCP client design

filesets:
    rtl:
        depend:
            - uwcse:beehive:common_inc
            - uwcse:basejump:bsg_mem
            - uwcse:basejump:bsg_misc
            - uwcse:beehive:data_converters
            - uwcse:beehive:misc
            - uwcse:beehive:empty_tile
            - uwcse:beehive:msgs
            - uwcse:beehive:eth
            - uwcse:beehive:ip
            - uwcse:beehive:udp
            - uwcse:beehive:dhcp_tile
            - uwcse:beehive:topology:0.2
            - uwcse:beehive:pyhp_generator
        file_type: systemVerilogSource

targets:
    default:
        filesets: [rtl]
        generate: [pyhp_generate]
    sim:
        default_tool: modelsim
        filesets: [rtl]
        generate: [pyhp_generate]
        toplevel: [dhcp_client_top]

generate:
    pyhp_generate:
        generator: pyhp_gen
        parameters:
            process_me: [[dhcp_client_top_gen.sv.pyv, dhcp_client_top_gen.sv]]
