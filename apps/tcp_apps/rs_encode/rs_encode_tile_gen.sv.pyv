`include "noc_defs.vh"
module rs_encode_tile
import apiary_noc_msg::*;
#(
<%
# Get the basic configuration object
import sys
import os
sys.path.append(os.environ["APIARY_OS_ROOT"] + "/util/generator/")
from apiary_generator import ApiaryConfig
sys.path.append(os.environ["BEEHIVE"] + "/tile_generator/")
from noc_if_gen import NocInterfaceGen
import logging
logging.basicConfig(level=logging.INFO)
design_path = os.environ["APIARY_DESIGN_ROOT"]
logging.info(f"Using tile config at {design_path}")
tile_config = ApiaryConfig(design_path + "/tile_config.xml")
noc_if_generator = NocInterfaceGen()
%>
     parameter SRC_X = -1
    ,parameter SRC_Y = -1
    ,parameter FALAFEL_X = -1
    ,parameter FALAFEL_Y = -1
    ,parameter MGMT_X = -1
    ,parameter MGMT_Y = -1
    ,parameter DST_DRAM_X = -1
    ,parameter DST_DRAM_Y = -1
)(
     input  clk
    ,input  rst
<%
    noc_if_str = noc_if_generator.genNocInterface(src="src", module="rs_encode",
         dst="dst", nocs=tile_config.nocs, noc_widths=tile_config.nocs_data_width)
    print(noc_if_str)
%>
);

    localparam DATA_NOC_W = `NOC_DATA_WIDTH;
    localparam CTRL_NOC_W = `CTRL_NOC_DATA_W;

<%
router_wires = noc_if_generator.genNocProcessorWires(inst_name="router", nocs=tile_config.nocs,
        noc_widths = tile_config.nocs_data_width)
print(router_wires)
%>
    
    logic                       monitor_sys_noc0_val;
    logic   [DATA_NOC_W-1:0]    monitor_sys_noc0_data;
    logic                       sys_monitor_noc0_rdy;

    logic                       sys_monitor_noc0_val;
    logic   [DATA_NOC_W-1:0]    sys_monitor_noc0_data;
    logic                       monitor_sys_noc0_rdy;

    logic                       monitor_sys_noc1_val;
    logic   [CTRL_NOC_W-1:0]    monitor_sys_noc1_data;
    logic                       sys_monitor_noc1_rdy;

    logic                       sys_monitor_noc1_val;
    logic   [CTRL_NOC_W-1:0]    sys_monitor_noc1_data;
    logic                       monitor_sys_noc1_rdy;
    
    logic                      monitor_app_ctrl_noc_val;
    logic   [DATA_NOC_W-1:0]   monitor_app_ctrl_noc_data;
    logic                      app_monitor_ctrl_noc_rdy;
    
    noc_router_block #(
         .SRC_X (SRC_X  )
        ,.SRC_Y (SRC_Y  )
    ) rs_encode_noc_router_block (
         .clk   (clk    )
        ,.rst   (rst    )
<%
    noc_ports = noc_if_generator.genNocInstantiation(src="src",
    port_name="router_block", dst="dst", noc_src="src", noc_dst="dst",
    module="rs_encode", nocs=tile_config.nocs)
    print(noc_ports)
    
    processor_ports = noc_if_generator.genNocProcessorInstantiation(module="router_block", 
        processor="process", inst_name="router", nocs=tile_config.nocs)
    print(processor_ports)
%>
    );
    
    // =========== NoC0 (data) =============
    beehive_credit_to_valrdy #(
        .NOC_DATA_W (`NOC_DATA_WIDTH    )
    ) tile_noc0_credit_to_valrdy (
         .clk   (clk)
        ,.reset (rst)
        //credit based interface 
        ,.src_ctovr_data    (router_ctovr_data_noc0_data    )
        ,.src_ctovr_val     (router_ctovr_data_noc0_val     )
        ,.ctovr_src_yummy   (ctovr_router_data_noc0_yummy   )

        //val/rdy interface
        ,.ctovr_dst_data    (sys_monitor_noc0_data          )
        ,.ctovr_dst_val     (sys_monitor_noc0_val           )
        ,.dst_ctovr_rdy     (monitor_sys_noc0_rdy           )
    );
    
    beehive_valrdy_to_credit #(
        .NOC_DATA_W (`NOC_DATA_WIDTH    )
    ) tile_noc0_valrdy_to_credit (
         .clk       (clk)
        ,.reset     (rst)

        //val/rdy interface
        ,.src_vrtoc_data    (monitor_sys_noc0_data          )
        ,.src_vrtoc_val     (monitor_sys_noc0_val           )
        ,.vrtoc_src_rdy     (sys_monitor_noc0_rdy           )

		//credit based interface	
        ,.vrtoc_dst_data    (vrtoc_router_data_noc0_data    )
        ,.vrtoc_dst_val     (vrtoc_router_data_noc0_val     )
        ,.dst_vrtoc_yummy   (router_vrtoc_data_noc0_yummy   )
    );
    
    // =========== NoC1 (ctrl) =============
    beehive_credit_to_valrdy #(
        .NOC_DATA_W (`CTRL_NOC_DATA_W    )
    ) tile_noc1_credit_to_valrdy (
         .clk   (clk)
        ,.reset (rst)
        //credit based interface 
        ,.src_ctovr_data    (router_ctovr_ctrl_noc1_data    )
        ,.src_ctovr_val     (router_ctovr_ctrl_noc1_val     )
        ,.ctovr_src_yummy   (ctovr_router_ctrl_noc1_yummy   )

        //val/rdy interface
        ,.ctovr_dst_data    (sys_monitor_noc1_data          )
        ,.ctovr_dst_val     (sys_monitor_noc1_val           )
        ,.dst_ctovr_rdy     (monitor_sys_noc1_rdy           )
    );
    
    beehive_valrdy_to_credit #(
        .NOC_DATA_W (`CTRL_NOC_DATA_W   )
    ) tile_noc1_valrdy_to_credit (
         .clk       (clk)
        ,.reset     (rst)

        //val/rdy interface
        ,.src_vrtoc_data    (monitor_sys_noc1_data          )
        ,.src_vrtoc_val     (monitor_sys_noc1_val           )
        ,.vrtoc_src_rdy     (sys_monitor_noc1_rdy           )

		//credit based interface	
        ,.vrtoc_dst_data    (vrtoc_router_ctrl_noc1_data    )
        ,.vrtoc_dst_val     (vrtoc_router_ctrl_noc1_val     )
        ,.dst_vrtoc_yummy   (router_vrtoc_ctrl_noc1_yummy   )
    );
    
    apiary_monitor #(
         .DATA_NOC_W    (`NOC_DATA_WIDTH    )
        ,.CTRL_NOC_W    (`CTRL_NOC_DATA_W   )
        ,.SRC_X         (SRC_X              )
        ,.SRC_Y         (SRC_Y              )
        ,.MGMT_X        (MGMT_X             )
        ,.MGMT_Y        (MGMT_Y             )
        ,.FALAFEL_X     (FALAFEL_X          )
        ,.FALAFEL_Y     (FALAFEL_Y          )
    ) monitor (
         .clk   (clk    )
        ,.rst   (rst    )

        ,.app_monitor_noc_val   (app_monitor_noc_val    )
        ,.app_monitor_noc_data  (app_monitor_noc_data   )
        ,.monitor_app_noc_rdy   (monitor_app_noc_rdy    )

        ,.monitor_app_noc_val   (monitor_app_noc_val    )
        ,.monitor_app_noc_data  (monitor_app_noc_data   )
        ,.app_monitor_noc_rdy   (app_monitor_noc_rdy    )
    
        ,.monitor_app_ctrl_noc_val (monitor_app_ctrl_noc_val    )
        ,.monitor_app_ctrl_noc_data(monitor_app_ctrl_noc_data   )
        ,.app_monitor_ctrl_noc_rdy (app_monitor_ctrl_noc_rdy    )

        ,.monitor_sys_noc0_val  (monitor_sys_noc0_val   )
        ,.monitor_sys_noc0_data (monitor_sys_noc0_data  )
        ,.sys_monitor_noc0_rdy  (sys_monitor_noc0_rdy   )

        ,.sys_monitor_noc0_val  (sys_monitor_noc0_val   )
        ,.sys_monitor_noc0_data (sys_monitor_noc0_data  )
        ,.monitor_sys_noc0_rdy  (monitor_sys_noc0_rdy   )

        ,.monitor_sys_noc1_val  (monitor_sys_noc1_val   )
        ,.monitor_sys_noc1_data (monitor_sys_noc1_data  )
        ,.sys_monitor_noc1_rdy  (sys_monitor_noc1_rdy   )

        ,.sys_monitor_noc1_val  (sys_monitor_noc1_val   )
        ,.sys_monitor_noc1_data (sys_monitor_noc1_data  )
        ,.monitor_sys_noc1_rdy  (monitor_sys_noc1_rdy   )
    );

    rs_encode_wrap #(
         .MONITOR_DATA_W    (`NOC_DATA_WIDTH    )
        ,.SRC_X             (SRC_X          )
        ,.SRC_Y             (SRC_Y          )
        ,.DST_DRAM_X        (DST_DRAM_X     )
        ,.DST_DRAM_Y        (DST_DRAM_Y     )
    ) rs_encoder (
         .clk   (clk    )
        ,.rst   (rst    )

        ,.app_monitor_noc_val       (app_monitor_noc_val        )
        ,.app_monitor_noc_data      (app_monitor_noc_data       )
        ,.monitor_app_noc_rdy       (monitor_app_noc_rdy        )

        ,.monitor_app_noc_val       (monitor_app_noc_val        )
        ,.monitor_app_noc_data      (monitor_app_noc_data       )
        ,.app_monitor_noc_rdy       (app_monitor_noc_rdy        )

        ,.monitor_app_ctrl_noc_val  (monitor_app_ctrl_noc_val   )
        ,.monitor_app_ctrl_noc_data (monitor_app_ctrl_noc_data  )
        ,.app_monitor_ctrl_noc_rdy  (app_monitor_ctrl_noc_rdy   )

    );
endmodule